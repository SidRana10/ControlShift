# Copy to .env and fill in. Never commit .env. Nothing below has a built-in secret or model default.
SQLITE_PATH=data/processed/controlshift.db
INDEX_DIR=data/indexes
RETRIEVAL_MODE=hybrid            # none | bm25 | dense | hybrid | hybrid_rerank

# LLM generation (optional: without these the API returns evidence bundles only)
LLM_PROVIDER=gemini              # answer generator: gemini | mistral (default gemini if unset)
GEMINI_API_KEY=                  # used when LLM_PROVIDER=gemini
GEMINI_MODEL=                    # set to a Gemini model id available to your key
MISTRAL_API_KEY=                 # used when LLM_PROVIDER=mistral (api.mistral.ai chat completions, JSON mode)
MISTRAL_MODEL=                   # e.g. mistral-small-latest; the model id the API actually served is recorded in eval results
LLM_TIMEOUT_SECONDS=30
REQUEST_TIMEOUT_SECONDS=90
GENERATION_CONTEXT_CHARS=12000   # evidence budget in the prompt
GENERATION_MAX_PASSAGE_CHARS=1500
LLM_MAX_ATTEMPTS=2               # first try + one repair retry

# LLM judge for answer-quality evaluation (independent of the generator; no silent fallback to GEMINI_MODEL)
JUDGE_PROVIDER=gemini            # gemini | groq (OpenAI-compatible API at api.groq.com)
JUDGE_MODEL=                     # required for judged runs; choosing the generator's model is NOT an independent evaluation
JUDGE_API_KEY=                   # defaults to GEMINI_API_KEY only for provider gemini; a groq judge needs its own key (or GROQ_API_KEY)
JUDGE_TIMEOUT_SECONDS=60
JUDGE_MAX_ATTEMPTS=1             # no automatic retry

API_HOST=127.0.0.1
API_PORT=8000
